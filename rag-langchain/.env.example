# Salin file ini menjadi `.env` lalu isi.

# LLM_BACKEND: "api" (OpenAI-compatible) atau "ollama" (ChatOllama native)
LLM_BACKEND=api

# --- bila LLM_BACKEND=api ------------------------------------------------
# OpenAI     : LLM_BASE_URL=https://api.openai.com/v1
# OpenRouter : LLM_BASE_URL=https://openrouter.ai/api/v1
# Groq       : LLM_BASE_URL=https://api.groq.com/openai/v1
# DeepSeek   : LLM_BASE_URL=https://api.deepseek.com/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- bila LLM_BACKEND=ollama ---------------------------------------------
# LLM_MODEL=qwen3:4b
# (base_url & api_key tidak dipakai ChatOllama; server di localhost:11434)

# --- Opsional -------------------------------------------------------------
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=1024

# ---- Reranker (pencarian 2 fase, default aktif) --------------------------
# Qwen3-Reranker-0.6B dari cache HuggingFace (offline); fallback aman ke
# urutan cosine bila model tidak termuat.
# RERANK=1
