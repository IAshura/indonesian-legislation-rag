# Salin file ini menjadi `.env` lalu isi nilainya.
# HANYA SATU backend yang aktif — tinggal isi 3 baris pertama.

# ---- Pilih satu: --------------------------------------------------------
# OpenAI     : LLM_BASE_URL=https://api.openai.com/v1
# OpenRouter : LLM_BASE_URL=https://openrouter.ai/api/v1
# Groq       : LLM_BASE_URL=https://api.groq.com/openai/v1
# DeepSeek   : LLM_BASE_URL=https://api.deepseek.com/v1
# Ollama     : LLM_BASE_URL=http://localhost:11434/v1   (api_key=ollama)

LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ---- Opsional (sudah ada default di config.py) ---------------------------
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=1024
# LLM_TIMEOUT=120

# ---- Reranker (pencarian 2 fase, default aktif) --------------------------
# Qwen3-Reranker-0.6B dimuat dari cache HuggingFace (offline). Bila model
# tidak ada, sistem otomatis fallback ke urutan cosine asli.
# RERANK=1
