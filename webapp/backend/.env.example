# .env.example — backend webapp RAG Hukum Indonesia
# Salin jadi .env bila ingin default LLM tanpa isi Setting di UI.
# Setting dari UI (localStorage + body request) SELALU mengalahkan .env.
#
# Bila file .env ini terisi, browser otomatis prefill Setting saat pertama
# dibuka (GET /api/llm/env-defaults). api_key TIDAK dikirim ke browser —
# backend memakainya sendiri bila request tanpa api_key. Muat ulang prefill:
# kosongkan field base_url + key di UI, atau hapus kunci
# `rag-hukum-settings-v2` di localStorage.

# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
